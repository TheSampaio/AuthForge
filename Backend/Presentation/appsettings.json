{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=UseHostFromUserSecrets;Port=UsePortFromUserSecrets;Database=authforge;Username=UseUsernameFromUserSecrets;Password=UsePasswordFromUserSecrets"
  },
  "JwtSettings": {
    "SecretKey": "UseSecretFromUserSecrets",
    "Issuer": "AuthForge",
    "Audience": "AuthForgeClients",
    "ExpirationInMinutes": 120
  },
  "CryptoSettings": {
    "Pepper": "UsePepperFromUserSecrets"
  }
}